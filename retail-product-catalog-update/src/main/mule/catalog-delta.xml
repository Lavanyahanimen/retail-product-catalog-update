<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
    <sub-flow name="catalog-deltaFlow">

        <ee:transform doc:name="Validate Product SKU">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    sku: "SKU-TSHIRT-BLK-M",
    productName: "Classic Cotton T-Shirt",
    price: 1299.00,
    classification: "NEW",
    errors: []
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <set-variable value="#[payload]" doc:name="Set Variable" doc:id="ebe73071-a5d5-461d-87d0-5c7bd19a0c99" variableName="incomingProduct"/>
		<choice doc:name="Choice" doc:id="dddf0383-2fa5-4ab2-817b-2ae611e0fa09">
			<when expression='#[payload.sku != "" and payload.productName != ""]'>
				<logger level="INFO" doc:name="Logger" doc:id="670f663d-94da-475d-bc99-bc9debde4280" message="Valid product received" />
			</when>
			<otherwise>
				<logger level="INFO" doc:name="Logger" doc:id="b07e5c00-875e-43fd-a214-f821dc33e079" message="Invalid product: SKU or product name is missing" />
			</otherwise>
		</choice>
		<set-variable value='#[{sku: "SKU-OTHER-001", productName: "Classic Cotton T-Shirt", price: 1299.00}]' doc:name="Set Variable" doc:id="ffe74e26-9a1e-4aca-bee6-fb38301b425d" variableName="existingProduct"/>
		<ee:transform doc:name="Transform Message" doc:id="f052478c-6023-472c-973d-f3e129497d3c" >
			<ee:message >
				<ee:set-payload ><![CDATA[
%dw 2.0
output application/json
var incoming = vars.incomingProduct
var existing = vars.existingProduct
var changedFields =
    (if (incoming.productName != existing.productName)
        ["productName"] else [])
    ++
    (if (incoming.price != existing.price)
        ["price"] else [])
---
{
    sku: incoming.sku,
    productName: incoming.productName,
    price: incoming.price,
    classification:
        if (incoming.sku != existing.sku)
            "NEW"
        else if (sizeOf(changedFields) > 0)
            "CHANGED"
        else
            "UNCHANGED",
    changedFields: changedFields
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO"
                doc:name="Log Delta Decision"
                message="#['Delta decision: ' ++ (payload.classification default &quot;UNKNOWN&quot;) ++ ', Changed fields: ' ++ write(payload.changedFields default [], 'application/json')]"/>

    </sub-flow>
<flow name="catalog-delta-testFlow">
    <scheduler>
        <scheduling-strategy>
            <fixed-frequency frequency="60000"/>
        </scheduling-strategy>
    </scheduler>

    <set-payload value='#[{
        sku: "SKU-TSHIRT-BLK-M",
        productName: "Classic Cotton T-Shirt",
        price: 1299.00
    }]' />

    <flow-ref name="catalog-deltaFlow"/>

    <logger level="INFO"
            message="#[write(payload, 'application/json')]"/>
</flow>
</mule>
